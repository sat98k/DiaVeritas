# =============================================================================
# DiaVeritas — .gitignore
# =============================================================================

# Secrets
.env
.env.*
.env*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Large data and model files
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
data/*.json
models/*
!models/.gitkeep
vector_store/*
!vector_store/.gitkeep
results/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
