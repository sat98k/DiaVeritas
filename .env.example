# =============================================================================
# DiaVeritas — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (choose one or configure multiple)
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Groq (fast free-tier inference for open models like llama-3)
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# HuggingFace Hub (for gated models / model downloads)
HUGGINGFACEHUB_API_TOKEN=

# ---------------------------------------------------------------------------
# PubMed / NCBI (optional, for corpus collection via API)
# ---------------------------------------------------------------------------
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# ---------------------------------------------------------------------------
# Active LLM configuration
# ---------------------------------------------------------------------------
# Options: openai | groq | google | anthropic | local
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Retrieval configuration
# ---------------------------------------------------------------------------
DENSE_RETRIEVAL_CANDIDATES=50
BM25_CANDIDATES=50
RERANKER_TOP_K=10
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_PERCENT=15

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Options: chromadb | faiss
VECTOR_STORE_BACKEND=chromadb
VECTOR_STORE_PATH=./vector_store

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# ---------------------------------------------------------------------------
# Cross-encoder reranker model
# ---------------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Biomedical NLI model
# ---------------------------------------------------------------------------
# NOTE: Do NOT set NLI_MODEL to a masked language model (e.g. BiomedBERT base).
# Only NLI-finetuned models work with the text-classification pipeline.
#
# Default (set in src/config.py — do not need to set here unless overriding):
#   MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli  (~700MB, strong general NLI)
#
# Alternative (SciFact-trained, smaller, ~200MB):
#   NLI_MODEL=tomaarsen/bert-base-cased-nli-scifact
#
# Uncomment ONE of the above to override the default:
# NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# NLI_MODEL=tomaarsen/bert-base-cased-nli-scifact

# ---------------------------------------------------------------------------
# Streamlit / API
# ---------------------------------------------------------------------------
STREAMLIT_PORT=8501
API_PORT=8000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
